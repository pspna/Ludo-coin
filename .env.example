# =====================================================================
# Ludo Royale - Environment Configuration
# =====================================================================
# The public URL of the live authoritative multiplayer backend (server/server.js).
#
# Production (e.g. Render / Railway):
# EXPO_PUBLIC_SERVER_URL=https://your-ludo-server.onrender.com
#
# Local development:
# EXPO_PUBLIC_SERVER_URL=http://localhost:3001
#
# NOTE: Vercel only hosts the client-side Expo web application.
# The WebSocket multiplayer server must be hosted on a persistent Node.js
# hosting provider like Render (using render.yaml) or Railway.
# Once deployed, copy your backend URL and add EXPO_PUBLIC_SERVER_URL
# in Vercel -> Project Settings -> Environment Variables (Production & Preview).
# =====================================================================
EXPO_PUBLIC_SERVER_URL=
